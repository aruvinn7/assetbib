# Salin nilai-nilai ini ke Vercel → Project Settings → Environment Variables.
# Untuk menjalankan `manage.py pindah_ke_server` dari laptop, set juga di terminal (lihat docs/DEPLOY-VERCEL.md).

# Wajib. Buat dengan: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# PostgreSQL. Integrasi Neon di Vercel mengisi DATABASE_URL otomatis;
# Supabase mengisi POSTGRES_URL (juga dikenali). Pakai URL pooler bila tersedia.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Penyimpanan foto & scan (S3-compatible, bucket PRIVAT)
MEDIA_BUCKET=assetms-media
MEDIA_ACCESS_KEY_ID=
MEDIA_SECRET_ACCESS_KEY=
# Supabase: https://<project>.supabase.co/storage/v1/s3 · Cloudflare R2: https://<account>.r2.cloudflarestorage.com · AWS: kosongkan
MEDIA_ENDPOINT_URL=
# Supabase: region proyek (mis. ap-southeast-1) · R2: auto · AWS: region bucket
MEDIA_REGION=
# Supabase: path · lainnya: kosongkan
MEDIA_ADDRESSING_STYLE=

# Opsional: domain sendiri (dipisah koma). *.vercel.app sudah otomatis diizinkan.
# DJANGO_ALLOWED_HOSTS=aset.contoh.co.id
# DJANGO_CSRF_TRUSTED_ORIGINS=https://aset.contoh.co.id
