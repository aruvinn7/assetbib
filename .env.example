# Env untuk server (Vercel). Isi di Vercel → Project Settings → Environment Variables.
# Panduan lengkap: docs/DEPLOY-VERCEL.md. Tanpa env apa pun, aplikasi di laptop tetap
# memakai db.sqlite3 dan folder media/.

# ── Wajib ───────────────────────────────────────────────────────────────
# Buat dengan: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# PostgreSQL Neon. Di Vercel pakai URL dengan "-pooler"; dari laptop (pindah_ke_server, migrate) pakai URL tanpa pooler.
# File unggahan otomatis disimpan di database ini juga (tabel BerkasMedia).
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# ── Opsional ────────────────────────────────────────────────────────────
# Domain sendiri (dipisah koma). *.vercel.app sudah otomatis diizinkan.
# DJANGO_ALLOWED_HOSTS=aset.contoh.co.id
# DJANGO_CSRF_TRUSTED_ORIGINS=https://aset.contoh.co.id

# Pindahkan file unggahan ke bucket S3-compatible (Cloudflare R2, Backblaze B2, AWS S3) bila database 1 GB tidak cukup.
# MEDIA_BUCKET=assetms-media
# MEDIA_ACCESS_KEY_ID=
# MEDIA_SECRET_ACCESS_KEY=
# MEDIA_ENDPOINT_URL=https://<account>.r2.cloudflarestorage.com
# MEDIA_REGION=auto
# MEDIA_ADDRESSING_STYLE=path
